---
/**
 * /play/ — the game detail page.
 *
 * Contains the full content set required of a detail page:
 * intro, gameplay, controls, tags, publisher, rating, screenshots, video,
 * FAQ, and related recommendations. The homepage is a separate, shorter entry
 * point; this is the page that answers "what is this game, actually".
 *
 * Route lives at /play/ because that is the keyword ("play <game>"), and the
 * Play button target is the outbound link, not this page.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGame, getPage, getGuides, resolveCharacters, resolveVideos } from '@/lib/content';
import { routes } from '@/lib/routes';
import { UI, formatDate } from '@/config/ui';
import { isIndexable } from '@/config/site';
import { breadcrumbNode, faqNode, gameNode } from '@/lib/jsonld';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import RatingStars from '@/components/ui/RatingStars.astro';
import FaqBlock from '@/components/content/FaqBlock.astro';
import VideoEmbed from '@/components/content/VideoEmbed.astro';
import ContentCard from '@/components/ui/ContentCard.astro';
import AdSlot from '@/components/ads/AdSlot.astro';

const game = await getGame();
const page = await getPage('play');
const origin = Astro.site?.origin ?? 'https://example.com';
const path = routes.play();
const S = page.data.sectionLabels;

const [guides, characters, videos] = await Promise.all([
  getGuides(),
  resolveCharacters(game.data.characterIds),
  resolveVideos(game.data.videoIds),
]);

const crumbs = [
  { name: UI.labels.home, path: routes.home() },
  { name: UI.nav.play, path },
];

const jsonLd = [
  gameNode({ origin, game }),
  breadcrumbNode(
    origin,
    crumbs.map((c) => ({ name: c.name, path: c.path }))
  ),
  ...(faqNode(game.data.faq) ? [faqNode(game.data.faq)!] : []),
];
---

<BaseLayout
  title={page.data.seo.title}
  description={page.data.seo.description}
  canonical={page.data.seo.canonical ?? path}
  indexable={isIndexable('play') && !page.data.seo.noindex}
  ogImage={game.data.cover.src}
  updated={game.data.updated}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: UI.nav.play }]} />

    <!-- Header -->
    <header class="grid gap-6 sm:grid-cols-[14rem_1fr] sm:items-start">
      <img
        src={game.data.cover.src}
        alt={game.data.cover.alt}
        width={game.data.cover.width}
        height={game.data.cover.height}
        class="w-full rounded-lg border border-ink-800"
        fetchpriority="high"
        decoding="async"
      />
      <div>
        <h1 class="text-3xl font-black tracking-tight sm:text-4xl">{page.data.h1}</h1>
        <p class="mt-2 text-ink-300">{game.data.tagline}</p>

        {game.data.rating && (
          <div class="mt-3">
            <RatingStars
              value={game.data.rating.value}
              best={game.data.rating.best}
              count={game.data.rating.count}
            />
          </div>
        )}

        <dl class="mt-4 grid gap-x-6 gap-y-1.5 text-xs sm:grid-cols-2">
          <div class="flex gap-2">
            <dt class="text-ink-500">{UI.labels.developer}</dt>
            <dd class="text-ink-200">{game.data.developer}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-ink-500">{UI.labels.publisher}</dt>
            <dd class="text-ink-200">{game.data.publisher}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-ink-500">{UI.labels.released}</dt>
            <dd class="text-ink-200">
              <time datetime={game.data.releaseDate.toISOString().slice(0, 10)}>
                {formatDate(game.data.releaseDate)}
              </time>
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-ink-500">{UI.labels.platforms}</dt>
            <dd class="text-ink-200">{game.data.platforms.join(' · ')}</dd>
          </div>
        </dl>

        <a
          href={game.data.playUrl}
          rel="noopener nofollow"
          class="mt-5 inline-block rounded-md bg-brand-500 px-6 py-2.5 text-sm font-bold text-ink-950 transition-colors hover:bg-brand-400"
        >
          {game.data.browserPlayable ? UI.cta.playFree : UI.cta.playNow}
        </a>
      </div>
    </header>

    <!-- Intro -->
    <section class="mt-10" aria-labelledby="intro-heading">
      <h2 id="intro-heading" class="text-xl font-bold">{S.about}</h2>
      <div class="prose-site mt-3">
        {game.data.intro.split('\n\n').map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </section>

    <AdSlot variant="leaderboard" slot="play-mid" />

    <!-- Gameplay -->
    <section class="mt-10" aria-labelledby="gameplay-heading">
      <h2 id="gameplay-heading" class="text-xl font-bold">{S.gameplay}</h2>
      <p class="mt-3 leading-relaxed text-ink-300">{game.data.gameplay.summary}</p>
      <dl class="mt-5 grid gap-px overflow-hidden rounded-lg border border-ink-800 bg-ink-800 sm:grid-cols-2">
        {game.data.gameplay.mechanics.map((m) => (
          <div class="bg-ink-900 p-4">
            <dt class="text-sm font-semibold text-ink-100">{m.label}</dt>
            <dd class="mt-1 text-sm leading-relaxed text-ink-400">{m.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Controls -->
    <section class="mt-10" aria-labelledby="controls-heading">
      <h2 id="controls-heading" class="text-xl font-bold">{S.controls ?? UI.labels.controls}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {game.data.controls.map((scheme) => (
          <div class="rounded-lg border border-ink-800 bg-ink-900/40 p-4">
            <p class="text-sm font-semibold text-ink-100">{scheme.device}</p>
            <dl class="mt-3 space-y-1.5">
              {scheme.bindings.map((b) => (
                <div class="flex items-baseline justify-between gap-3">
                  <dt class="text-sm text-ink-400">{b.action}</dt>
                  <dd class="rounded border border-ink-700 bg-ink-850 px-2 py-0.5 font-mono text-[11px] text-ink-200">
                    {b.keys}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <!-- Tags -->
    <section class="mt-10" aria-labelledby="tags-heading">
      <h2 id="tags-heading" class="text-xl font-bold">{S.tags ?? UI.labels.tags}</h2>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {game.data.tags.map((tag) => (
          <span class="rounded-full border border-ink-800 bg-ink-900 px-3 py-1 text-xs text-ink-300">
            {tag}
          </span>
        ))}
      </div>
    </section>

    <!-- Screenshots -->
    <section class="mt-10" aria-labelledby="shots-heading">
      <h2 id="shots-heading" class="text-xl font-bold">{S.screenshots ?? UI.labels.screenshots}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {game.data.screenshots.map((shot) => (
          <figure class="overflow-hidden rounded-lg border border-ink-800">
            <img
              src={shot.src}
              alt={shot.alt}
              width={shot.width}
              height={shot.height}
              loading="lazy"
              decoding="async"
              class="aspect-video w-full object-cover"
            />
            {shot.caption && (
              <figcaption class="border-t border-ink-800 bg-ink-900/40 px-3 py-2 text-xs text-ink-400">
                {shot.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>

    <!-- Video -->
    {videos.length > 0 && (
      <section class="mt-10" aria-labelledby="video-heading">
        <h2 id="video-heading" class="text-xl font-bold">{S.video ?? UI.labels.video}</h2>
        <div class="mt-4">
          <VideoEmbed
            url={videos[0]!.data.url}
            title={videos[0]!.data.title}
            thumbnail={videos[0]!.data.thumbnail}
          />
        </div>
      </section>
    )}

    <!-- Related: guides -->
    {guides.length > 0 && (
      <section class="mt-10" aria-labelledby="rel-guides">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="rel-guides" class="text-xl font-bold">{S.relatedGuides ?? UI.labels.relatedGuides}</h2>
          <a href={routes.guides()} class="text-sm font-medium text-brand-400 hover:text-brand-500">
            {UI.cta.viewAll}
          </a>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {guides.slice(0, 4).map((g) => (
            <ContentCard
              href={routes.guide(g.id)}
              title={g.data.title}
              excerpt={g.data.excerpt}
              meta={`${UI.labels.updated} ${formatDate(g.data.updated)}`}
              routeKey="guides"
            />
          ))}
        </div>
      </section>
    )}

    <!-- Related: characters -->
    {characters.length > 0 && (
      <section class="mt-10" aria-labelledby="rel-chars">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="rel-chars" class="text-xl font-bold">{S.relatedCharacters ?? UI.labels.relatedCharacters}</h2>
          <a href={routes.characters()} class="text-sm font-medium text-brand-400 hover:text-brand-500">
            {UI.cta.viewAll}
          </a>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {characters.map((c) => (
            <ContentCard
              href={routes.character(c.id)}
              title={c.data.name}
              excerpt={c.data.summary}
              image={c.data.portrait}
              meta={c.data.role}
              routeKey="characters"
            />
          ))}
        </div>
      </section>
    )}

    <FaqBlock faq={game.data.faq} />
  </div>
</BaseLayout>
