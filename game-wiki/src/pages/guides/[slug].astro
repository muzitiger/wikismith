---
/**
 * /guides/<slug>/ — the guide detail template. Serves all three kinds;
 * the `blocks` union is what makes one template cover how-to, walkthrough,
 * and tier list without branching in the page.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGame, getGuides, resolveCharacters } from '@/lib/content';
import type { Guide } from '@/lib/content';
import { routes } from '@/lib/routes';
import { UI, formatDate } from '@/config/ui';
import { isIndexable } from '@/config/site';
import { guideNodes } from '@/lib/jsonld';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import BlockRenderer from '@/components/content/BlockRenderer.astro';
import FaqBlock from '@/components/content/FaqBlock.astro';
import AdSlot from '@/components/ads/AdSlot.astro';
import RelatedRail from '@/components/content/RelatedRail.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
};

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const game = await getGame();
const origin = Astro.site?.origin ?? 'https://example.com';

const path = routes.guide(guide.id);
const crumbs = [
  { name: UI.labels.home, path: routes.home() },
  { name: UI.nav.guides, path: routes.guides() },
  { name: guide.data.title, path },
];

// Tier-list guides also emit an ItemList of the characters they rank.
// Names must be resolved from the characters collection — never the raw IDs,
// which would put "sable" in the structured data instead of "Sable".
const tierCharacters =
  guide.data.kind === 'tierlist' ? await resolveCharacters(guide.data.characterIds) : [];
const tierItems =
  tierCharacters.length > 0
    ? tierCharacters.map((c) => ({ name: c.data.name, path: routes.character(c.id) }))
    : undefined;

const jsonLd = guideNodes({ origin, game }, guide, crumbs, tierItems);
---

<BaseLayout
  title={guide.data.seo.title}
  description={guide.data.seo.description}
  canonical={guide.data.seo.canonical ?? path}
  indexable={isIndexable('guides') && !guide.data.seo.noindex}
  ogImage={guide.data.seo.ogImage}
  ogType="article"
  published={guide.data.published}
  updated={guide.data.updated}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: UI.nav.guides, href: routes.guides() }, { name: guide.data.title }]} />

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="min-w-0">
        <header>
          <p class="text-xs font-semibold uppercase tracking-wider text-brand-400">
            {guide.data.kind === 'howto' ? 'How-to' : guide.data.kind === 'walkthrough' ? 'Walkthrough' : 'Tier list'}
          </p>
          <h1 class="mt-2 text-3xl font-black leading-tight tracking-tight sm:text-4xl">
            {guide.data.title}
          </h1>
          <p class="mt-3 text-lg leading-relaxed text-ink-300">{guide.data.excerpt}</p>

          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-ink-500">
            <span>
              {UI.labels.updated}
              <time class="ml-1 text-ink-300" datetime={guide.data.updated.toISOString().slice(0, 10)}>
                {formatDate(guide.data.updated)}
              </time>
            </span>
            {guide.data.tags.length > 0 && (
              <span class="flex flex-wrap gap-1.5">
                {guide.data.tags.map((tag) => (
                  <span class="rounded-full border border-ink-800 px-2 py-0.5 text-[11px] text-ink-400">
                    {tag}
                  </span>
                ))}
              </span>
            )}
          </div>
        </header>

        <AdSlot variant="leaderboard" slot="guide-top" />

        <div class="prose-site mt-2">
          <BlockRenderer blocks={guide.data.blocks} />
        </div>

        <FaqBlock faq={guide.data.faq} />

        <AdSlot variant="leaderboard" slot="guide-bottom" />
      </div>

      <aside class="lg:pt-8">
        <div class="sticky top-20 space-y-6">
          <div class="rounded-lg border border-ink-800 bg-ink-900/40 p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">
              {UI.labels.contents}
            </p>
            <ol class="mt-2 space-y-1.5">
              {guide.data.blocks
                .filter((b) => b.type === 'h2')
                .map((b) => (
                  <li class="text-sm text-ink-300">{b.type === 'h2' ? b.text : ''}</li>
                ))}
            </ol>
          </div>

          <RelatedRail
            heading={UI.labels.relatedGuides}
            routeKey="guides"
            items={(await getGuides())
              .filter((g) => g.id !== guide.id && g.data.kind === guide.data.kind)
              .slice(0, 4)
              .map((g) => ({
                href: routes.guide(g.id),
                title: g.data.title,
                excerpt: g.data.excerpt,
              }))}
          />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
