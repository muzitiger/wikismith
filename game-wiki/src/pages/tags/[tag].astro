---
/**
 * /tags/<tag>/ — everything carrying one tag.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGame, getTags, getGuides, getCharacters } from '@/lib/content';
import type { Tag } from '@/lib/content';
import { routes } from '@/lib/routes';
import { UI, UI_TEMPLATES, formatDate } from '@/config/ui';
import { isIndexable } from '@/config/site';
import { tagNodes } from '@/lib/jsonld';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ContentCard from '@/components/ui/ContentCard.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const tags = await getTags();
  return tags.map((tag) => ({ params: { tag: tag.id }, props: { tag } }));
};

interface Props {
  tag: Tag;
}

const { tag } = Astro.props;
const game = await getGame();
const [guides, characters] = await Promise.all([getGuides(), getCharacters()]);
const origin = Astro.site?.origin ?? 'https://example.com';
const path = routes.tag(tag.id);

const taggedGuides = guides.filter((g) => g.data.tags.includes(tag.id));
const taggedChars = characters.filter((c) => c.data.tags.includes(tag.id));
const total = taggedGuides.length + taggedChars.length;

const items = [
  ...taggedGuides.map((g) => ({ name: g.data.title, path: routes.guide(g.id) })),
  ...taggedChars.map((c) => ({ name: c.data.name, path: routes.character(c.id) })),
];

const jsonLd = tagNodes({ origin, game }, [{ name: UI.labels.home, path: routes.home() }, { name: UI.labels.tags, path: routes.tags() }, { name: tag.data.label, path }], tag, items);
---

<BaseLayout
  title={UI_TEMPLATES.tagTitle(tag.data.label, game.data.name)}
  description={tag.data.description ?? UI_TEMPLATES.tagDescription(tag.data.label, game.data.name)}
  canonical={path}
  indexable={isIndexable('tags')}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: UI.labels.tags, href: routes.tags() }, { name: tag.data.label }]} />

    <h1 class="text-3xl font-black tracking-tight sm:text-4xl">{tag.data.label}</h1>
    {tag.data.description && <p class="mt-3 max-w-2xl text-ink-300">{tag.data.description}</p>}
    <p class="mt-2 font-mono text-xs text-ink-500">{total} results</p>

    {taggedGuides.length > 0 && (
      <section class="mt-10" aria-labelledby="tg">
        <h2 id="tg" class="text-xl font-bold">{UI.nav.guides}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {taggedGuides.map((g) => (
            <ContentCard
              href={routes.guide(g.id)}
              title={g.data.title}
              excerpt={g.data.excerpt}
              meta={`${UI.labels.updated} ${formatDate(g.data.updated)}`}
              routeKey="guides"
            />
          ))}
        </div>
      </section>
    )}

    {taggedChars.length > 0 && (
      <section class="mt-10" aria-labelledby="tc">
        <h2 id="tc" class="text-xl font-bold">{UI.nav.characters}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {taggedChars.map((c) => (
            <ContentCard
              href={routes.character(c.id)}
              title={c.data.name}
              excerpt={c.data.summary}
              image={c.data.portrait}
              meta={c.data.role}
              routeKey="characters"
            />
          ))}
        </div>
      </section>
    )}

    {total === 0 && <p class="mt-10 text-ink-400">{UI.labels.noResults}</p>}
  </div>
</BaseLayout>
