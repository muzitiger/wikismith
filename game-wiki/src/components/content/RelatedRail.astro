---
/**
 * RelatedRail — the "see also" list on every detail page. Reads its items
 * from the page so the page decides relevance, not this component.
 */
import { isOpen, type RouteKey } from '@/config/site';

interface Item {
  href: string;
  title: string;
  excerpt?: string;
}

interface Props {
  heading: string;
  items: Item[];
  routeKey: RouteKey;
}

const { heading, items, routeKey } = Astro.props;
const linked = isOpen(routeKey);
---

{
  items.length > 0 && (
    <div class="rounded-lg border border-ink-800 bg-ink-900/40 p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">{heading}</p>
      <ul class="mt-3 space-y-3">
        {items.map((item) => (
          <li>
            {linked ? (
              <a href={item.href} class="group block">
                <p class="text-sm font-medium leading-snug text-ink-200 group-hover:text-brand-400">
                  {item.title}
                </p>
                {item.excerpt && (
                  <p class="mt-0.5 line-clamp-2 text-xs text-ink-500">{item.excerpt}</p>
                )}
              </a>
            ) : (
              <div>
                <p class="text-sm font-medium leading-snug text-ink-300">{item.title}</p>
                {item.excerpt && (
                  <p class="mt-0.5 line-clamp-2 text-xs text-ink-600">{item.excerpt}</p>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}
