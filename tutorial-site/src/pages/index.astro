---
/**
 * ROOT HUB — the all-topics landing page.
 *
 * Its only job is to route a visitor to the right topic in one click and to
 * pass authority down to each topic hub. It deliberately does NOT list
 * individual tutorials: every tutorial should be reachable via its topic,
 * so the crawl graph stays three levels deep at most.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { UI } from '@/config/ui';
import { PAGE_COPY } from '@/config/pages';
import { routes } from '@/lib/routes';
import { SITE } from '@/config/site';
import { getTopics, getTutorials, getComparisons } from '@/lib/content';
import { webSiteNode, faqNode } from '@/lib/jsonld';
import RichText from '@/components/content/RichText.astro';

const origin = (Astro.site ?? new URL(SITE.url)).origin;
const topics = await getTopics();
const primaries = topics.filter((t) => t.data.kind === 'primary' && t.data.status === 'live');
const stubs = topics.filter((t) => t.data.kind === 'stub');

const allTutorials = await getTutorials();
const liveIds = new Set(primaries.map((t) => t.id));
const recent = allTutorials
  .filter((t) => liveIds.has(t.data.topic))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 6);

const comparisons = await getComparisons();

const counts = new Map<string, number>();
for (const t of allTutorials) counts.set(t.data.topic, (counts.get(t.data.topic) ?? 0) + 1);

const homeFaq = PAGE_COPY.home.faq;
const jsonLd = [
  webSiteNode({ origin }, {
    name: UI.siteName,
    description: UI.siteTagline,
  }),
  ...(faqNode(homeFaq) ? [faqNode(homeFaq)!] : []),
];
---

<BaseLayout
  title={PAGE_COPY.home.title}
  description={PAGE_COPY.home.description}
  titleSuffix={undefined}
  jsonLd={jsonLd}
  ogType="website"
>
  <section class="max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-wider text-accent/70">Programmatic tutorial index</p>
    <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight text-white md:text-5xl">
      Step-by-step guides that tell you <span class="text-accent">what should happen</span>
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-400">
      Every guide states the version it was tested against, gives you a command to confirm each step
      worked, and links straight to the error page for the failure you are most likely to hit.
    </p>
  </section>

  <!-- Topics -->
  <section class="mt-14">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-xl font-semibold text-ink-100">{UI.nav.topics}</h2>
      <span class="font-mono text-xs text-ink-600">{primaries.length} active</span>
    </div>

    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        primaries.map((t) => (
          <a
            href={routes.topic(t.id)}
            class="group flex flex-col rounded-xl border border-ink-800 bg-ink-900/40 p-5 transition-colors hover:border-ink-600 hover:bg-ink-900"
          >
            <div class="flex items-center gap-3">
              <span
                class="grid size-9 shrink-0 place-items-center rounded-lg font-mono text-sm font-bold"
                style={`background:${t.data.color ?? '#7dd3fc'}1a;color:${t.data.color ?? '#7dd3fc'}`}
                aria-hidden="true"
              >
                {t.data.name.charAt(0)}
              </span>
              <div class="min-w-0">
                <h3 class="truncate text-base font-semibold text-ink-100 group-hover:text-white">{t.data.name}</h3>
                <p class="truncate text-xs text-ink-500">v{t.data.currentVersion} · {t.data.category}</p>
              </div>
            </div>
            <RichText as="p" class="mt-4 line-clamp-3 text-sm leading-relaxed text-ink-400" text={t.data.tagline} />
            <p class="mt-4 border-t border-ink-800 pt-3 text-xs text-ink-500">
              {counts.get(t.id) ?? 0} guides
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Recently updated -->
  {
    recent.length > 0 && (
      <section class="mt-14">
        <h2 class="text-xl font-semibold text-ink-100">{UI.section.latest}</h2>
        <ul class="mt-5 divide-y divide-ink-800 rounded-xl border border-ink-800">
          {recent.map((t) => {
            const topic = topics.find((x) => x.id === t.data.topic);
            return (
              <li>
                <a
                  href={routes.tutorial(t.data.topic, t.id)}
                  class="group flex flex-col gap-1.5 px-5 py-4 transition-colors hover:bg-ink-900/60 sm:flex-row sm:items-center sm:gap-4"
                >
                  <span class="shrink-0 rounded border border-ink-700 px-2 py-0.5 font-mono text-[0.625rem] uppercase tracking-wider text-ink-500">
                    {topic?.data.nameShort ?? t.data.topic}
                  </span>
                  <span class="flex-1 text-sm font-medium text-ink-200 group-hover:text-white">
                    {t.data.h1}
                  </span>
                  <span class="shrink-0 font-mono text-xs text-ink-600">
                    {t.data.updated.toISOString().slice(0, 10)}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <!-- Comparisons -->
  {
    comparisons.length > 0 && (
      <section class="mt-14">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-xl font-semibold text-ink-100">{UI.nav.comparisons}</h2>
          <a href={routes.comparisons()} class="text-xs text-accent hover:underline">
            {UI.cta.viewAll} &rarr;
          </a>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {comparisons.slice(0, 4).map((c) => (
            <a
              href={routes.comparison(c.id)}
              class="group rounded-xl border border-ink-800 bg-ink-900/40 p-5 transition-colors hover:border-ink-600 hover:bg-ink-900"
            >
              <h3 class="text-sm font-semibold text-ink-100 group-hover:text-white">{c.data.h1}</h3>
              <RichText as="p" class="mt-2 line-clamp-2 text-xs leading-relaxed text-ink-500" text={c.data.answer} />
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="mt-14 max-w-3xl">
    <h2 class="text-xl font-semibold text-ink-100">{UI.section.faq}</h2>
    <div class="mt-4 divide-y divide-ink-800 border-y border-ink-800">
      {
        homeFaq.map((item) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-start gap-3 py-3.5 text-[0.9375rem] font-medium text-ink-200 hover:text-white">
              <span class="mt-0.5 text-accent/60 transition-transform group-open:rotate-90" aria-hidden="true">
                <svg class="size-4" viewBox="0 0 16 16" fill="none">
                  <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <RichText class="flex-1" text={item.q} />
            </summary>
            <RichText as="div" class="pb-4 pl-7 pr-2 text-sm leading-relaxed text-ink-400" text={item.a} />
          </details>
        ))
      }
    </div>
  </section>

  <!-- Reference topics -->
  {
    stubs.length > 0 && (
      <section class="mt-14">
        <h2 class="text-xl font-semibold text-ink-100">Comparison references</h2>
        <p class="mt-2 text-sm text-ink-500">
          These pages exist so side-by-side comparisons have a stable place to point. They are not
          tutorial sets.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {stubs.map((t) => (
            <a
              href={routes.topic(t.id)}
              class="rounded-md border border-ink-800 bg-ink-900/50 px-3 py-1.5 text-xs text-ink-400 transition-colors hover:border-ink-600 hover:text-ink-200"
            >
              {t.data.name}
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
