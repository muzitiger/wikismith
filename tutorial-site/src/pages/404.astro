---
/**
 * 404. Astro writes this to 404.html because of build.format: 'directory'.
 *
 * It links to the topic hubs rather than dumping a full sitemap — a lost
 * visitor needs three plausible next steps, not forty.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { UI } from '@/config/ui';
import { routes } from '@/lib/routes';
import { getTopics } from '@/lib/content';
import RichText from '@/components/content/RichText.astro';

const topics = await getTopics();
const primaries = topics.filter((t) => t.data.kind === 'primary' && t.data.status === 'live');
---

<BaseLayout
  title={UI.notFound.title}
  description={UI.notFound.body}
  noindex={true}
  titleSuffix={UI.siteName}
  ogType="website"
>
  <div class="max-w-2xl py-10">
    <p class="font-mono text-sm text-accent/70">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">
      {UI.notFound.title}
    </h1>
    <p class="mt-4 text-base leading-relaxed text-ink-400">{UI.notFound.body}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={routes.hub()}
        class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-accent-ink transition-opacity hover:opacity-90"
      >
        {UI.notFound.cta}
      </a>
      <a
        href={routes.comparisons()}
        class="rounded-lg border border-ink-700 px-4 py-2 text-sm text-ink-300 transition-colors hover:border-ink-500 hover:text-white"
      >
        {UI.nav.comparisons}
      </a>
    </div>

    {
      primaries.length > 0 && (
        <div class="mt-12">
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">{UI.nav.topics}</p>
          <ul class="mt-3 space-y-2">
            {primaries.map((t) => (
              <li>
                <a href={routes.topic(t.id)} class="text-sm text-ink-300 hover:text-accent">
                  {t.data.name} — <RichText text={t.data.tagline} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</BaseLayout>
