---
/**
 * TAG DETAIL — /{topic}/tags/{tag}/
 *
 * Lists both guides and error pages for a tag. Errors belong here because a
 * reader searching for "build errors" wants the error pages, not only the
 * guides that mention them.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';
import { UI } from '@/config/ui';
import { routes } from '@/lib/routes';
import { SITE } from '@/config/site';
import {
  getTopics,
  getTopicTagCounts,
  getTutorialsByTopic,
  getErrorsByTopic,
  getTag,
} from '@/lib/content';
import { breadcrumbNode, collectionPageNode, itemListNode } from '@/lib/jsonld';
import RichText from '@/components/content/RichText.astro';

export async function getStaticPaths() {
  const topics = await getTopics();
  const primary = topics.filter((t) => t.data.kind === 'primary');
  const out: Array<{ params: Record<string, string>; props: Record<string, unknown> }> = [];
  for (const t of primary) {
    const counts = await getTopicTagCounts(t.id);
    for (const c of counts) {
      out.push({ params: { topic: t.id, tag: c.slug }, props: { topic: t, tag: c.slug } });
    }
  }
  return out;
}

interface Props {
  topic: Awaited<ReturnType<typeof getTopics>>[number];
  tag: string;
}

const { topic, tag } = Astro.props;
const origin = (Astro.site ?? new URL(SITE.url)).origin;
const topicName = topic.data.nameShort ?? topic.data.name;
const path = routes.tag(topic.id, tag);

const tagDoc = await getTag(tag);
const label = tagDoc?.data.label ?? tag;

const tutorials = (await getTutorialsByTopic(topic.id)).filter((t) => t.data.tags.includes(tag));
const errors = (await getErrorsByTopic(topic.id)).filter((e) => e.data.tags.includes(tag));

const crumbs = [
  { name: UI.siteName, path: routes.hub() },
  { name: topicName, path: routes.topic(topic.id) },
  { name: 'Tags', path: routes.tags(topic.id) },
  { name: label, path },
];

const jsonLd = [
  breadcrumbNode({ origin }, crumbs),
  collectionPageNode({ origin }, {
    name: `${label} — ${topicName}`,
    description: `All ${topicName} guides and error pages tagged ${label}.`,
    path,
    updated: topic.data.updated,
  }),
  itemListNode({ origin }, {
    name: label,
    path,
    items: [
      ...tutorials.map((t) => ({ name: t.data.h1, path: routes.tutorial(topic.id, t.id) })),
      ...errors.map((e) => ({ name: e.data.message, path: routes.error(topic.id, e.id) })),
    ],
  }),
];
---

<BaseLayout
  title={`${label}: ${topicName} Guides and Errors`}
  description={`Every ${topicName} guide, error page and fix tagged ${label} — ${tutorials.length + errors.length} pages in one list, each with its tested version and expected results.`}
  canonical={path}
  noindex={topic.data.status === 'draft'}
  titleSuffix={topicName}
  jsonLd={jsonLd}
  ogType="website"
>
  <Breadcrumbs crumbs={crumbs} />

  <header class="max-w-2xl">
    <p class="text-xs font-medium uppercase tracking-wider text-accent/70">Tagged</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-white md:text-4xl">{label}</h1>
    {tagDoc?.data.description && (
      <p class="mt-4 text-base leading-relaxed text-ink-400">{tagDoc.data.description}</p>
    )}
    <p class="mt-3 font-mono text-xs text-ink-600">
      {tutorials.length + errors.length} pages
    </p>
  </header>

  {
    tutorials.length > 0 && (
      <section class="mt-10">
        <h2 class="border-b border-ink-800 pb-3 text-lg font-semibold text-ink-100">Guides</h2>
        <ul class="divide-y divide-ink-800/70">
          {tutorials.map((t) => (
            <li>
              <a
                href={routes.tutorial(topic.id, t.id)}
                class="group flex flex-col gap-1 py-4 transition-colors hover:bg-ink-900/40 sm:px-2"
              >
                <span class="text-[0.9375rem] font-medium text-ink-200 group-hover:text-white">
                  {t.data.h1}
                </span>
                <RichText class="line-clamp-2 text-sm text-ink-500" text={t.data.excerpt} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    errors.length > 0 && (
      <section class="mt-12">
        <h2 class="border-b border-ink-800 pb-3 text-lg font-semibold text-ink-100">Errors</h2>
        <ul class="divide-y divide-ink-800/70">
          {errors.map((e) => (
            <li>
              <a
                href={routes.error(topic.id, e.id)}
                class="group flex flex-col gap-1 py-4 transition-colors hover:bg-ink-900/40 sm:px-2"
              >
                <code class="font-mono text-[0.8125rem] text-ink-200 group-hover:text-white">
                  {e.data.message}
                </code>
                <RichText class="text-sm text-ink-500" text={e.data.answer} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {tutorials.length + errors.length === 0 && (
    <p class="mt-10 text-sm text-ink-500">Nothing tagged {label} yet.</p>
  )}

  <div class="mt-14">
    <a href={routes.tags(topic.id)} class="text-sm text-accent hover:underline">
      &larr; All topics
    </a>
  </div>
</BaseLayout>
