---
/**
 * SEO — the single exit point for <title>, description, canonical, OG.
 *
 * Every page passes a `seo` object read from content. Nothing here invents copy.
 * The title suffix is appended HERE, which is why content `seo.title` is
 * bounded to 60 chars — that's the pre-suffix budget.
 */
import { SITE } from '@/config/site';
import { UI } from '@/config/ui';

interface Props {
  title: string;
  description: string;
  /** Absolute canonical. If omitted, derived from Astro.url. */
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Appended to <title> after a separator. Pass the topic name for topic pages. */
  titleSuffix?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  ogImage,
  ogType = 'article',
  titleSuffix,
  publishedTime,
  modifiedTime,
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);

/**
 * Canonical MUST be absolute. Search engines ignore a relative canonical, which
 * silently turns every page into a duplicate of whatever they guessed — the
 * exact failure that is invisible in the browser and expensive in the index.
 *
 * Callers pass a path (`/astro/tutorials/`), so this resolves it against the
 * configured origin. A caller that passes an already-absolute URL is left alone.
 */
const canonicalUrl = canonical
  ? new URL(canonical, site).href
  : new URL(Astro.url.pathname, site).href;

const fullTitle = titleSuffix ? `${title} | ${titleSuffix}` : title;

/**
 * og:image fallback.
 *
 * Must be a raster image: most social crawlers (Facebook, X, LinkedIn, Slack)
 * ignore SVG and render a blank card. public/og-default.png is 1200x630, the
 * size all of them accept. Regenerate it from scripts/og-card.html after
 * changing the site name or tagline — see public/README.txt.
 */
const ogImageUrl = ogImage
  ? new URL(ogImage, site).href
  : new URL('/og-default.png', site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
)}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={UI.siteName} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:image" content={ogImageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
