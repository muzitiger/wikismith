---
/**
 * B10 Breadcrumbs — visible trail, same data as the BreadcrumbList JSON-LD.
 *
 * Last item is plain text, not a link: a self-referencing link is a crawl waste
 * and confuses screen readers.
 */
interface Props {
  crumbs: Array<{ name: string; path: string }>;
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-ink-500">
    {
      crumbs.map((c, i) => {
        const last = i === crumbs.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            {i > 0 && <span aria-hidden="true" class="text-ink-700">/</span>}
            {last ? (
              <span class="text-ink-400" aria-current="page">
                {c.name}
              </span>
            ) : (
              <a href={c.path} class="transition-colors hover:text-accent">
                {c.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
