---
/**
 * B1 AnswerBox — the one-sentence conclusion.
 *
 * First block on every detail page, above the fold. No heading. Not collapsible.
 * This is the block that wins the featured snippet and the AI-overview citation,
 * so it must be self-contained: readable with zero surrounding context.
 *
 * Inline markdown is rendered (`code`, **bold**, [link]) because the answer is
 * the most-read sentence on the page — literal backticks there look like a bug.
 */
import { inlineHtml } from '@/lib/blocks';

interface Props {
  answer: string;
  label: string;
}

const { answer, label } = Astro.props;
const html = inlineHtml(answer);
---

<div
  class="relative overflow-hidden rounded-xl border border-accent/25 bg-accent/[0.06] px-5 py-5 md:px-6"
  data-block="answer"
>
  <div class="absolute inset-y-0 left-0 w-[3px] bg-accent" aria-hidden="true"></div>
  <p class="text-[0.6875rem] font-semibold uppercase tracking-wider text-accent/80">{label}</p>
  <p
    class="answer-body mt-2 text-lg md:text-xl font-medium leading-relaxed text-ink-100"
    set:html={html}
  />
</div>

<style>
  /* Inline code inside the answer needs to sit on its own tint, not the
     global prose background, or it disappears against the accent wash. */
  .answer-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: rgb(0 0 0 / 0.45);
    color: var(--color-accent);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    border: 1px solid var(--color-accent);
    border-color: color-mix(in oklab, var(--color-accent) 30%, transparent);
    white-space: nowrap;
  }
  .answer-body :global(strong) {
    color: #fff;
    font-weight: 600;
  }
  .answer-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
