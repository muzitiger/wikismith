---
/**
 * B3 PrereqList — prerequisites, split into required and optional.
 *
 * Deliberately NOT numbered and NOT rendered inside the step sequence.
 * Google reads HowTo.step as the ordered instructions; a prerequisite sitting
 * in that array shifts every position by one and breaks the rich result.
 *
 * `verify` renders as a copyable check block, so a reader who fails a prereq
 * finds out before step 1 instead of halfway through step 4.
 */
import { routes } from '@/lib/routes';
import type { CollectionEntry } from 'astro:content';
import { inlineHtml } from '@/lib/blocks';

interface Props {
  prerequisites: CollectionEntry<'tutorials'>['data']['prerequisites'];
  topic: string;
  /** Tutorial titles by id, for prerequisite cross-links. */
  linkTitles: Record<string, string>;
}

const { prerequisites, topic, linkTitles } = Astro.props;

const required = prerequisites.filter((p) => p.required);
const optional = prerequisites.filter((p) => !p.required);

const kindIcon: Record<string, string> = {
  tool: 'M2 10h12M8 4v12',
  account: 'M8 8a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM3 14c0-2.2 2.2-3.5 5-3.5s5 1.3 5 3.5',
  knowledge: 'M3 3.5h4.5L12 8l-4.5 4.5H3z',
  file: 'M4 2h5l3 3v9H4z',
};
---

<div data-block="prerequisites">
  <ul class="space-y-3">
    {
      required.map((p) => (
        <li class="flex gap-3 text-sm leading-relaxed">
          <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded border border-ink-700 bg-ink-800 text-ink-400">
            <svg class="size-3" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d={kindIcon[p.kind] ?? kindIcon.tool} stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-ink-200">
              <span set:html={inlineHtml(p.text)} />
              {p.version && <span class="ml-1.5 font-mono text-xs text-ink-400">{p.version}</span>}
            </p>
            {p.verify && (
              <div class="mt-2 rounded-md border border-ink-700 bg-ink-900 px-3 py-2">
                <p class="text-[0.6875rem] uppercase tracking-wider text-ink-500">Check it</p>
                <code class="mt-1 block font-mono text-xs text-accent break-all">$ {p.verify.cmd}</code>
                <p class="mt-1 text-xs text-ink-400">
                  Expect: <span class="font-mono text-ink-300">{p.verify.expect}</span>
                </p>
              </div>
            )}
            {p.tutorialId && linkTitles[p.tutorialId] && (
              <a
                href={routes.tutorial(topic, p.tutorialId)}
                class="mt-1.5 inline-block text-xs text-accent hover:underline"
              >
                {linkTitles[p.tutorialId]} &rarr;
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  {
    optional.length > 0 && (
      <div class="mt-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">Optional</p>
        <ul class="mt-2 space-y-1.5">
          {optional.map((p) => (
            <li class="flex gap-2 text-sm text-ink-400">
              <span class="text-ink-600">—</span>
              <span>{p.text}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {required.length === 0 && optional.length === 0 && (
    <p class="text-sm text-ink-500">Nothing to install first — this works in a fresh environment.</p>
  )}
</div>
