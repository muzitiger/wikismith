---
/**
 * B2 MetaBar — difficulty, time, tested version, last update.
 *
 * `testedWith` is the E-E-A-T signal: it tells the reader this page was run
 * against a specific version on a specific date. Pages without it read like
 * AI-generated filler, and readers bounce.
 */
import { UI } from '@/config/ui';

interface Props {
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  totalMinutes?: number;
  stepCount: number;
  testedVersion: string;
  testedDate: Date;
  environment?: string;
  updated: Date;
}

const { difficulty, totalMinutes, stepCount, testedVersion, testedDate, environment, updated } =
  Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const difficultyTone: Record<string, string> = {
  beginner: 'text-ok border-ok/30 bg-ok/10',
  intermediate: 'text-warn border-warn/30 bg-warn/10',
  advanced: 'text-danger border-danger/30 bg-danger/10',
};
---

<div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-ink-400" data-block="meta">
  <span class:list={['rounded-full border px-2.5 py-1 font-medium', difficultyTone[difficulty]]}>
    {UI.meta.difficulty}: {UI.meta[difficulty]}
  </span>

  {totalMinutes && (
    <span class="inline-flex items-center gap-1.5">
      <svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.2"></circle>
        <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
      </svg>
      {totalMinutes} {UI.meta.minRead}
    </span>
  )}

  <span>{stepCount} {UI.meta.steps}</span>

  <span class="inline-flex items-center gap-1.5">
    <svg class="size-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 1.5l2 4 4.5.6-3.2 3.1.8 4.4L8 11.5l-4.1 2.1.8-4.4L1.5 6.1 6 5.5l2-4z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"></path>
    </svg>
    {UI.meta.testedWith} {testedVersion}
  </span>

  {environment && <span class="text-ink-500">{environment}</span>}

  <span class="text-ink-500">
    {UI.meta.updated} <time datetime={updated.toISOString().slice(0, 10)}>{fmt(updated)}</time>
  </span>

  <span class="sr-only">
    Verified on {fmt(testedDate)} against version {testedVersion}.
  </span>
</div>
